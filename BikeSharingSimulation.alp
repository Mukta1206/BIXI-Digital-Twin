	</Folders>
	<ActiveObjectClasses>
		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1775735511999</Id>
			<Name><![CDATA[Main]]></Name>
			<Import><![CDATA[import java.io.*;
import java.util.*;]]></Import>
			<StartupCode><![CDATA[traceln("Working dir: " + new File(".").getAbsolutePath());

// ================================
// CSV READ
// ================================

ArrayList<String[]> rows = new ArrayList<>();

try {
    BufferedReader br = new BufferedReader(
        new FileReader("/Users/satishmahato/Models/BikeSharingSimulation/bixi_stations.csv")
    );

    String line;

    br.readLine(); // skip header

    while ((line = br.readLine()) != null) {
        rows.add(line.split(","));
    }

    br.close();

    traceln("CSV Loaded. Rows: " + rows.size());

} catch (Exception e) {
    traceln("ERROR LOADING CSV");
    e.printStackTrace();
}


// ================================
// 🔹 DEMAND CALCULATION (GLOBAL)
// ================================

// ❗ IMPORTANT: NO "int[]" here
hourlyDemand = new int[24];

for (String[] r : rows) {
    try {
        int hour = Integer.parseInt(r[10].trim()); // column K

        if (hour >= 0 && hour < 24) {
            hourlyDemand[hour]++;
        }

    } catch (Exception e) {
        // skip bad rows
    }
}

// print demand
for (int h = 0; h < 24; h++) {
    traceln("Hour " + h + " demand: " + hourlyDemand[h]);
}


// ================================
// 🔹 STATIONS INITIALIZATION
// ================================

int i = 0;

for (Station s : stations1) {

    if (i >= rows.size()) break;

    String[] r = rows.get(i);

    try {
        s.name = r[0];
        s.lat = Double.parseDouble(r[2]);
        s.lon = Double.parseDouble(r[3]);

        s.capacity = 20;
        s.bikes = s.capacity / 2;

        s.main = this;

    } catch (Exception e) {
        traceln("Skipping bad row: " + i);
    }

    i++;
}

traceln("Stations initialized: " + i);
// 🔥 IMPORTANT: Link Station → Main
for (Station s : stations1) {
    s.main = this;
}]]></StartupCode>
